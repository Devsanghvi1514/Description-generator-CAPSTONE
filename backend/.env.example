# Local MongoDB example: mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=deep_caption
ENABLE_TRANSFORMER_MODEL=1
VISION_MODEL=microsoft/Florence-2-base
# Set this to the output of train_blip_flickr30k.py after training.
# TRAINED_BLIP_MODEL=models/blip-flickr30k
# Safe laptop training defaults:
# BLIP_BASE_MODEL=Salesforce/blip-image-captioning-base
# BLIP_MAX_TRAIN_SAMPLES=200
# BLIP_MAX_EVAL_SAMPLES=50
# BLIP_BATCH_SIZE=1
# BLIP_GRADIENT_ACCUMULATION=16
# BLIP_EPOCHS=1
# BLIP_MAX_STEPS=100
# BLIP_USE_CPU=1
# BLIP_FP16=0
